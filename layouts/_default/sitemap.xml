{{ printf "<?xml version=\"1.0\" encoding=\"utf-8\" standalone=\"yes\"?>" | safeHTML }}
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  {{- $built := slice "product" "alternatives" }}
  {{- range .Pages }}
  {{- if and .RelPermalink (ne .Kind "404") (ne .Layout "404") (ne .Params.sitemap false) }}
  {{- $stamp := time.AsTime "0001-01-01T00:00:00Z" }}
  {{- if eq .Kind "page" }}
  {{- if in $built .Section }}
  {{- $stamp = now.UTC }}
  {{- else if or (eq .Section "blog") (eq .Params.category "products") }}
  {{- $stamp = .Lastmod.UTC }}
  {{- end }}
  {{- end }}
  <url>
    <loc>{{ partial "page-url.html" . }}</loc>
    {{- if not $stamp.IsZero }}
    <lastmod>{{ $stamp.Format "2006-01-02T15:04:05-07:00" | safeHTML }}</lastmod>
    {{- end }}
  </url>
  {{- end }}
  {{- end }}
  {{- with site.GetPage "/blog" }}
  {{- $listURL := partial "page-url.html" . }}
  {{- range (.Paginate (partial "blog-pages.html" .)).Pagers }}
  {{- if gt .PageNumber 1 }}
  <url>
    <loc>{{ printf "%s%d/" $listURL .PageNumber }}</loc>
  </url>
  {{- end }}
  {{- end }}
  {{- end }}
</urlset>
